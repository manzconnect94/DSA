# ============================================================
# 🧠 CONCEPT: Environment configuration (.env / dotenv)
# WHY IT MATTERS (interview angle): Interviewers ask "how do you handle
#   config across dev/staging/prod?" The answer: 12-factor style — config
#   lives in the environment, not in code. Secrets never get committed,
#   because anything in git history is effectively public forever (even
#   after a later delete commit).
# HOW IT WORKS HERE: copy this file to `.env` and fill real values.
#   `.env` is gitignored; THIS file is committed so a new developer knows
#   exactly which variables exist without ever seeing the secrets.
# ============================================================

# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Mongoose connection string. maxPoolSize is set in config/db.js, not here.
MONGO_URI=mongodb://127.0.0.1:27017/mern_interview_boilerplate
MONGO_URI_TEST=mongodb://127.0.0.1:27017/mern_interview_boilerplate_test

# ---- JWT ----
# Use two DIFFERENT secrets. If they were the same, a refresh token would
# also validate as an access token -> instant privilege escalation bug.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_me_with_a_long_random_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Redis (optional) ----
# If unreachable, the app silently falls back to an in-memory Map cache.
# See config/redis.js for why that fallback is a dev convenience and a
# production anti-pattern.
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=60

# ---- CORS ----
# Comma-separated allowlist. NOT a wildcard, because credentials:true and
# origin:* are mutually exclusive in the CORS spec.
CLIENT_ORIGIN=http://localhost:5173

# ---- Security / limits ----
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# ---- Feature flags used by the demos ----
ENABLE_SOCKET_IO=true
ENABLE_CRON_JOBS=false
LOG_LEVEL=debug
